static class bookRental
{ private int rentalID;
  private String rentalDate;
  private userAcc rUserAcc;
  private LinkedList<Book> rbookList;

  public bookRental (int RID, String rDate, userAcc rUserAcc)
  { this.rentalID = RID;
    this.rentalDate = rDate;
    this.rUserAcc = rUserAcc;
    this.rbookList = new ArrayList<>();}

  public void setrentalDate (String rDate) //setter = setting the variable for getter
  {this.rentalDate = rDate; }

  public String getrentalDate() //getter = read/retrieve data
  {return rentalDate;}

  public int getrentalID ()
  {return rentalID; }

  public void setrentalID (int RID)
  {this.rentalID = RID;}

  public void setrUserAcc (userAcc rUserAcc)
  {this.rUserAcc = rUserAcc;}

  public userAcc getrUserAcc ()
  {return rUserAcc;}

  public void addBook1(Book Book1)
  {this.rbookList.add(Book1);}

  public void removeBook1(Book Book1)
  {this.rbookList.remove(Book1);}

  public double totalRprice()
  {double total = 0.0;
    for (Book Book1 : rbookList)
    {total += Book1.getbrentalPr();}
    return total;}
};

