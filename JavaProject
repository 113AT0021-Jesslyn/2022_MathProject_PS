static class Book
{ private int BID; // data hiding (encapsulation)
  private String bName; //Fields
  private String bDesc;
  private String bGenre;
  private double rPrice; //double = a primitive data type

  public Book (int BID, String bName, String bDesc, String bGenre, double brentalPr) //The constructor
  { this.BID = BID; //Arguments
    this.bName = bName;
    this.bDesc = bDesc;
    this.bGenre = bGenre;
    this.rPrice = brentalPr;}

  public String getbDesc () //getter = read/retrieve data
  {return bDesc;}

  public void setbDesc (String bDesc)
  {this.bDesc = bDesc;}

  public void setBID (int BID) //setter = setting the variable for getter
  {this.BID = BID;}

  public int getBID ()
  {return BID;}

  public void setrPrice (double brentalPr)
  {this.rPrice = brentalPr;}

  public double getbrentalPr()
  {return rPrice;}

  public String getbName()
  {return bName;}

  public void setbName (String bName)
  {this.bName = bName;}

  public void setbGenre (String bGenre)
  {this.bGenre = bGenre;}

  public String getbGenre ()
  {return bGenre;}
};

