        return guess == ans

    def getAns (eq):   #For the user's answer input
        print(eq, end= "")
        result = float(input(" = "))
        return result

    def maths (index, calculate): #The math calculation for the questions
        num1 = random.randint(0,20) #random numbers generator
        num2 = random.randint(1,20)
        if index == 1:
            eq = "What is " + str(num1) + " + " + str(num2)
            ans = num1 + num2
            userAns = getAns(eq)
            calculate = solutions(userAns, ans, calculate)
            return calculate
        elif index == 2:
            eq = "What is " + str(num1) + " - " + str(num2)
            ans = num1 - num2
            userAns = getAns(eq)
            calculate = solutions(userAns, ans, calculate)
            return calculate
        elif index == 3:
            eq = "What is " +str(num1) + " * " + str(num2)
            ans = num1 * num2
            userAns = getAns(eq)
            calculate = solutions(userAns, ans, calculate)
            return calculate
        elif index == 4:
            eq = "What is " + str(num1) + " / " + str(num2)
            ans = num1 / num2
            userAns = getAns(eq)
            calculate = solutions(userAns, ans, calculate)
            return calculate
        else:
            operators = {
                '+': operator.add,
                '-': operator.sub,
                '*': operator.mul,
                '/': operator.truediv,    #operators generator
            }
            randOp = random.choice(list(operators.keys()))   #Program for the random equation
            eq = (f"What is " + str(num1) + randOp + str(num2))
            ans = operators.get(randOp)(num1,num2)
            userAns = getAns(eq)
            calculate = solutions(userAns, ans, calculate)
            return calculate

